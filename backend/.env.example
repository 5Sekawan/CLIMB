# CLIMB Backend Environment Variables Example
# Copy this to .env on your VM instance and fill in the values

# Server Configuration
PORT=8080
NODE_ENV=development

# MongoDB Configuration
# For local container use: mongodb://admin:password123@mongodb:27017/climb?authSource=admin
MONGO_URI=mongodb://<user>:<password>@<host>:<port>/climb?authSource=admin

# Google Cloud Configuration
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=us-central1

# BigQuery Configuration
# Adjust dataset based on branch (climb_prod, climb_dev_1, climb_dev_2)
BQ_DATASET_ID=climb_dev_1
BQ_TABLE_KNOWLEDGE=geological_knowledge
BQ_TABLE_EXTERNAL_DATA=external_mineral_data
BQ_TABLE_ACTUALS=actual_production

# Google Earth Engine Configuration
GEE_SERVICE_ACCOUNT=your-gee-service-account@your-project.iam.gservice-account.com

# Vertex AI Configuration
VERTEX_AI_MODEL_ID=gemini-1.5-pro

# Secret Keys (GCP Service Account JSON should be pointed via GOOGLE_APPLICATION_CREDENTIALS)
GOOGLE_APPLICATION_CREDENTIALS=./config/gcp-service-account.json
