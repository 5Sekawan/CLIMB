# CLIMB Backend Environment Variables Example
# Copy this to .env on your VM instance and fill in the values

# Server Configuration
PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Security Configuration
JWT_SECRET=your-secure-jwt-secret-key-change-this-in-production

# MongoDB Configuration
# For local container use: mongodb://admin:password123@mongodb:27017/climb?authSource=admin
MONGO_URI=mongodb://<user>:<password>@<host>:<port>/climb?authSource=admin

# Google Cloud Configuration
GCP_PROJECT_ID=your-billing-project-id
GCP_LOCATION=us-central1

# BigQuery Configuration
# BQ_DATA_PROJECT_ID: The project where the datasets/tables actually reside.
# If left empty, it defaults to GCP_PROJECT_ID.
BQ_DATA_PROJECT_ID=g-cb-aiativeagenticragvertica
BQ_DATASET_ID=climb_dev_1
BQ_TABLE_KNOWLEDGE=geological_knowledge
BQ_TABLE_EXTERNAL_DATA=external_mineral_data
BQ_TABLE_ACTUALS=actual_production

# Google Earth Engine Configuration
GEE_SERVICE_ACCOUNT=your-gee-service-account@your-project.iam.gservice-account.com

# Google GenAI (Gemini) Configuration
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_ID=gemini-2.0-flash

# Google Maps API (Geocoding & Elevation)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Required APIs: Geocoding API, Elevation API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Secret Keys (GCP Service Account JSON for BigQuery/GCS/GEE)
GOOGLE_APPLICATION_CREDENTIALS=./config/gcp-service-account.json
